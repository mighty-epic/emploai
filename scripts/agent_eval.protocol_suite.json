    {
      "name": "tool-surface-sanity",
      "prompt": "Open a simple page in the isolated browser, capture the main heading, save it into a text file named protocol_browser_heading.txt in the current workspace, open that file so it is visible on the desktop, and also tell me what main app or window is currently visible on screen. Verify each step and keep the changes harmless.",
      "expectations": {
        "required_tool_sequence": [
          [
            "browser_navigate",
            "open_browser"
          ],
          [
            "browser_snapshot",
            "observe_browser",
            "browser_read_text"
          ],
          "write_file",
          [
            "open_file",
            "execute_command",
            "run_command"
          ],
          [
            "describe_screen",
            "observe_desktop",
            "ocr_screen"
          ]
        ],
        "tool_arg_checks": [
          {
            "tool": "write_file",
            "contains_all": [
              "protocol_browser_heading.txt",
              "Example Domain"
            ]
          }
        ],
        "artifact_checks": [
          {
            "path": "protocol_browser_heading.txt",
            "must_exist": true,
            "contains_all": [
              "Example Domain"
            ]
          }
        ],
        "final_answer_forbidden_phrases": [
          "error in model generation",
          "context window"
        ],
        "max_unsupported_tool_attempts": 0,
        "max_tool_errors": 0,
        "min_tool_calls": 5
      }
    },
