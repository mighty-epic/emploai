{
  "name": "agent-eval-protocol-suite",
  "profile": "protocol-suite",
  "workspace": "tests/fixtures/agent_eval/protocol_suite",
  "model": "gpt-5.4-mini",
  "variant": "standard",
  "enabled_tool_packs": [
    "interactive_desktop",
    "browser_isolated",
    "workspace_write",
    "workspace_read",
    "web_research",
    "scheduler",
    "app_runtime"
