{
  "name": "kraitos-mobile",
  "version": "0.1.0-beta.14.6",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:web": "expo start --web",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "ios": "expo run:ios",
    "export:web": "expo export --platform web",
    "release:check": "python ../../scripts/check_release_hygiene.py",
    "cleanup:packages": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/cleanup_release_packages.ps1",
    "prebuild:android:apk": "npm run release:check",
    "build:android:apk": "eas build --platform android --profile preview",
    "prebuild:android:local-apk": "npm run release:check",
    "build:android:local-apk": "eas build --platform android --profile local-apk",
    "prebuild:android:playstore": "npm run release:check",
    "build:android:playstore": "eas build --platform android --profile playstore",
    "postbuild:android:apk": "npm run cleanup:packages",
    "postbuild:android:local-apk": "npm run cleanup:packages",
    "postbuild:android:playstore": "npm run cleanup:packages",
    "submit:android:playstore": "eas submit --platform android --latest"
  },
  "dependencies": {
    "expo": "~54.0.35",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "qrcode-generator": "^2.0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "typescript": "^5.6.3"
  }
}
