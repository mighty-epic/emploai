{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "KRAITOS_ALLOW_CLEARTEXT": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "KRAITOS_ALLOW_CLEARTEXT": "0"
      }
    },
    "apk": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "KRAITOS_ALLOW_CLEARTEXT": "0"
      }
    },
    "local-apk": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "KRAITOS_ALLOW_CLEARTEXT": "1"
      }
    },
    "playstore": {
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      },
      "env": {
        "KRAITOS_ALLOW_CLEARTEXT": "0"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      },
      "env": {
        "KRAITOS_ALLOW_CLEARTEXT": "0"
      }
    }
  }
}
