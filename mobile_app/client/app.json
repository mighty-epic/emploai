{
  "expo": {
    "name": "EmploAI App",
    "slug": "emploai-app",
    "scheme": "emploai",
    "version": "0.1.0",
    "orientation": "portrait",
    "android": {
      "package": "com.emploai.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Allow EmploAI App to capture voice input for live conversations."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow EmploAI App to upload screenshots and images.",
          "cameraPermission": "Allow EmploAI App to capture photos for uploads."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f2332be3-09a9-40ad-aab2-872b51113d9b"
      }
    },
    "owner": "mighty_epic"
  }
}
