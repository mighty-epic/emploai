EMPLOAI_REMOTE_CONTROL_HOST=127.0.0.1
EMPLOAI_REMOTE_CONTROL_PORT=8787
EMPLOAI_REMOTE_CONTROL_LOG_LEVEL=info
EMPLOAI_ENV=production

# Remote desktop/mobile websocket routing modes:
# - single_process: direct in-process websocket routing; keep workers at 1.
# - sqlite_broker: command queue in EMPLOAI_HOME SQLite DB for multi-worker on one VPS/shared disk.
EMPLOAI_REMOTE_CONTROL_ROUTING_MODE=sqlite_broker
EMPLOAI_REMOTE_CONTROL_WORKERS=1
# Emergency bypass only; do not enable for public release automation.
EMPLOAI_REMOTE_CONTROL_ALLOW_UNSAFE_MULTIPROCESS=0

# Required in production for legacy signed local routes.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
EMPLO_APP_SECRET=

# Keep disabled in production so unexpected crashes do not expose tracebacks or secrets.
EMPLOAI_DEBUG_ERROR_RESPONSES=0

# Runtime home for the VPS-side control-plane state.
EMPLOAI_HOME=/var/lib/emploai-remote

# Model providers for VPS-side app endpoints that still need them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Optional: protect legacy local pair-start bootstrap if you still expose it.
EMPLO_APP_PAIRING_SECRET=

# Google OAuth sign-in for mobile/desktop cloud accounts.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.kraitos.app/api/remote/auth/google/callback

# Email OTP delivery for regular email/password signup and login.
# Missing delivery config fails account creation. Use `console` only for local/dev code logs.
EMPLOAI_EMAIL_BACKEND=resend
EMPLOAI_EMAIL_FROM=EmploAI <no-reply@kraitos.app>
RESEND_API_KEY=

# Optional but recommended for restoring encrypted user secrets across VPS rebuilds.
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# If omitted, the service creates /var/lib/emploai-remote/remote_secrets.key with user-only permissions.
EMPLOAI_REMOTE_SECRETS_KEY=
