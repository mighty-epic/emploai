# Copy values into your shell environment before scheduling with Postiz.
# Do not commit real API keys or channel IDs.

POSTIZ_BASE_URL=http://localhost:4007
POSTIZ_API_KEY=

# Fill these from:
# python scripts/postiz_kraitos_operator.py --list-integrations
POSTIZ_X_INTEGRATION_ID=
POSTIZ_LINKEDIN_INTEGRATION_ID=
POSTIZ_INSTAGRAM_INTEGRATION_ID=
POSTIZ_FACEBOOK_INTEGRATION_ID=
POSTIZ_TIKTOK_INTEGRATION_ID=
POSTIZ_YOUTUBE_INTEGRATION_ID=

# Fill these after uploading the rendered HyperFrames MP4 through:
# python scripts/postiz_kraitos_operator.py --upload-media kraitos-launch-short --upload
POSTIZ_KRAITOS_SHORT_MEDIA_ID=
POSTIZ_KRAITOS_SHORT_MEDIA_PATH=
