  "content": "\"\"\"\nVoice Agent - A conversational AI that can talk and control the computer.\nUses OpenAI's APIs for speech recognition, text generation, and speech synthesis.\n\"\"\"\n\nimport os\nimport sys\nimport json\nimport time\nimport subprocess\nimport threading\nfrom pathlib import Path\nfrom datetime import datetime\nfrom typing import Optional, Dict, Any\n\ntry:\n    import pyaudio\n    import pyttsx3\n    from pydub import AudioSegment\n    from pydub.playback import play\n    import requests\n    from openai import OpenAI\nexcept ImportError as e:\n    print(f\"Missing dependency: {e}\")\n    print(\"Installing required packages...\")\n    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\",\n                          \"openai\", \"pyaudio\", \"pyttsx3\", \"pydub\", \"requests\"])\n    print(\"Dependencies installed. Please run the script again.\")\n    sys.exit(1)\n\nclass VoiceAgent:\n    def __init__(self, api_key: Optional[str] = None):\n        \"\"\"Initialize the Voice Agent with OpenAI API.\"\"\"\n        self.api_key = api_key or os.getenv(\"OPENAI_API_KEY\")\n        if not self.api_key:\n            raise ValueError(\"OPENAI_API_KEY not set. Please set it as an environment variable.\")\n        \n        self.client = OpenAI(api_key=self.api_key)\n        self.conversation_history = []\n        self.is_running = True\n        self.tts_engine = pyttsx3.init()\n        self.tts_engine.setProperty('rate', 150)\n        \n        # System prompt for the agent\n        self.system_prompt = \"\"\"You are a helpful voice assistant that can control a Windows computer.\nYou can help the user with:\n- Web searches and information retrieval\n- File operations (reading, writing, organizing files)\n- Running applications and scripts\n- System information and status\n- General conversation and assistance\n\nBe concise and conversational. When you need to perform actions, describe what you're doing.\nAlways ask for confirmation before performing potentially destructive operations.\"\"\"\n        \n        self.conversation_history.append({\n            \"role\": \"system\",\n            \"content\": self.system_prompt\n        })\n        \n        print(\"\u2713 Voice Agent initialized successfully\")\n        print(f\"\u2713 Using OpenAI API\")\n        print(f\"\u2713 TTS Engine: {self.tts_engine.init()}\")\n    \n    def speak(self, text: str):\n        \"\"\"Convert text to speech and play it.\"\"\"\n        try:\n            print(f\"\\n\ud83d\udd0a Agent: {text}\\n\")\n            self.tts_engine.say(text)\n            self.tts_engine.runAndWait()\n        except Exception as e:\n            print(f\"Error in TTS: {e}\")\n    \n    def listen(self) -> str:\n        \"\"\"Record audio from microphone and convert to text using OpenAI.\"\"\"\n        try:\n            print(\"\\n\ud83c\udfa4 Listening... (speak now)\")\n            \n            # Use ffmpeg to record audio\n            audio_file = \"temp_audio.wav\"\n            duration = 10  # Max 10 seconds per message\n            \n            # Simple recording using sox or ffmpeg\n            record_cmd = [\n                \"ffmpeg\", \"-f\", \"dshow\", \"-i\", \"audio=\\\"Microphone\\\"\",\n                \"-t\", str(duration), \"-q:a\", \"9\", \"-acodec\", \"libmp3lame\",\n                \"-b:a\", \"192k\", audio_file, \"-y\"\n            ]\n            \n            print(\"Recording... Press Ctrl+C to stop early or wait for timeout\")\n            try:\n                subprocess.run(record_cmd, capture_output=True, timeout=duration+2)\n            except FileNotFoundError:\n                print(\"\u26a0\ufe0f  ffmpeg not found. Trying alternative method...\")\n                # Fallback: use pyaudio directly for simple recording\n                self._record_with_pyaudio(audio_file, duration)\n            \n            if os.path.exists(audio_file):\n                # Transcribe using OpenAI Whisper API\n                with open(audio_file, \"rb\") as f:\n                    transcript = self.client.audio.transcriptions.create(\n                        model=\"whisper-1\",\n                        file=f\n                    )\n                \n                text = transcript.text\n                print(f\"\ud83d\udcdd You: {text}\")\n                os.remove(audio_file)\n                return text\n            else:\n                print(\"\u26a0\ufe0f  Audio recording failed\")\n                return \"\"\n        \n        except KeyboardInterrupt:\n            print(\"\\n\u23f8\ufe0f  Recording stopped by user\")\n            return \"\"\n        except Exception as e:\n            print(f\"Error in listening: {e}\")\n            return \"\"\n    \n    def _record_with_pyaudio(self, filename: str, duration: int):\n        \"\"\"Fallback: Record audio using pyaudio directly.\"\"\"\n        try:\n            CHUNK = 1024\n            FORMAT = 8  # pyaudio.paInt16\n            CHANNELS = 1\n            RATE = 44100\n            \n            p = pyaudio.PyAudio()\n            \n            stream = p.open(format=FORMAT, channels=CHANNELS, rate=RATE,\n                          input=True, frames_per_buffer=CHUNK)\n            \n            frames = []\n            for _ in range(0, int(RATE / CHUNK * duration)):\n                data = stream.read(CHUNK)\n                frames.append(data)\n            \n            stream.stop_stream()\n            stream.close()\n            p.terminate()\n            \n            # Save as WAV\n            with open(filename, 'wb') as wf:\n                wf.write(b''.join(frames))\n            \n            print(f\"\u2713 Recorded {duration}s of audio\")\n        except Exception as e:\n            print(f\"PyAudio recording error: {e}\")\n    \n    def process_message(self, user_message: str) -> str:\n        \"\"\"Send user message to OpenAI and get response.\"\"\"\n        if not user_message.strip():\n            return \"\"\n        \n        self.conversation_history.append({\n            \"role\": \"user\",\n            \"content\": user_message\n        })\n        \n        try:\n            response = self.client.chat.completions.create(\n                model=\"gpt-4\",\n                messages=self.conversation_history,\n                max_tokens=500,\n                temperature=0.7\n            )\n            \n            assistant_message = response.choices[0].message.content\n            self.conversation_history.append({\n                \"role\": \"assistant\",\n                \"content\": assistant_message\n            })\n            \n            return assistant_message\n        \n        except Exception as e:\n            error_msg = f\"Error processing message: {e}\"\n            print(error_msg)\n            return error_msg\n    \n    def run(self):\n        \"\"\"Main loop for the voice agent.\"\"\"\n        print(\"\\n\" + \"=\"*60)\n        print(\"\ud83c\udf99\ufe0f  VOICE AGENT STARTED\")\n        print(\"=\"*60)\n        print(\"Commands:\")\n        print(\"  - Speak naturally and I'll respond\")\n        print(\"  - Type 'quit' or 'exit' to stop\")\n        print(\"  - Type 'clear' to reset conversation\")\n        print(\"=\"*60 + \"\\n\")\n        \n        # Start with a greeting\n        greeting = \"Hello! I'm your voice assistant. I can help you search the web, manage files, and control your computer. What can I do for you?\"\n        self.speak(greeting)\n        \n        while self.is_running:\n            try:\n                # Get user input (either voice or text for fallback)\n                print(\"\\nOptions: [1] Voice input, [2] Text input, [3] Quit: \", end=\"\")\n                choice = input().strip().lower()\n                \n                if choice in ['3', 'quit', 'exit']:\n                    self.speak(\"Goodbye! See you next time.\")\n                    self.is_running = False\n                    break\n                \n                if choice == '2' or choice == 'text':\n                    user_message = input(\"Type your message: \").strip()\n                elif choice in ['1', 'voice']:\n                    user_message = self.listen()\n                else:\n                    print(\"Please enter 1, 2, or 3\")\n                    continue\n                \n                if not user_message:\n                    continue\n                \n                if user_message.lower() in ['clear', 'reset']:\n                    self.conversation_history = [{\"role\": \"system\", \"content\": self.system_prompt}]\n                    self.speak(\"Conversation cleared.\")\n                    continue\n                \n                # Process and respond\n                response = self.process_message(user_message)\n                if response:\n                    self.speak(response)\n            \n            except KeyboardInterrupt:\n                self.speak(\"Agent shutting down...\")\n                self.is_running = False\n            except Exception as e:\n                print(f\"Unexpected error: {e}\")\n                self.speak(\"Sorry, I encountered an error. Please try again.\")\n    \n    def cleanup(self):\n        \"\"\"Cleanup resources.\"\"\"\n        try:\n            self.tts_engine.stop()\n        except:\n            pass\n        print(\"\\n\u2713 Voice Agent shutdown complete\")\n\n\nif __name__ == \"__main__\":\n    try:\n        agent = VoiceAgent()\n        agent.run()\n    except Exception as e:\n        print(f\"Fatal error: {e}\")\n        sys.exit(1)\n    finally:\n        try:\n            agent.cleanup()\n        except:\n            pass\n",
