  "path": "voice_agent_advanced.py",
  "content": "\"\"\"\nAdvanced Voice Agent - Enhanced with web search, file operations, and more\n\"\"\"\n\nimport os\nimport sys\nimport json\nimport time\nimport subprocess\nimport threading\nfrom pathlib import Path\nfrom datetime import datetime\nfrom typing import Optional, Dict, Any, List\nimport requests\nfrom urllib.parse import quote\n\ntry:\n    from openai import OpenAI\n    import pyttsx3\nexcept ImportError as e:\n    print(f\"Missing dependency: {e}\")\n    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\",\n                          \"openai\", \"pyttsx3\", \"requests\", \"python-dotenv\"])\n    print(\"Dependencies installed. Please run the script again.\")\n    sys.exit(1)\n\nclass AdvancedVoiceAgent:\n    def __init__(self, api_key: Optional[str] = None):\n        \"\"\"Initialize the Advanced Voice Agent.\"\"\"\n        self.api_key = api_key or os.getenv(\"OPENAI_API_KEY\")\n        if not self.api_key:\n            raise ValueError(\"OPENAI_API_KEY not found. Run: python setup_agent.py\")\n        \n        self.client = OpenAI(api_key=self.api_key)\n        self.conversation_history = []\n        self.is_running = True\n        self.tts_engine = pyttsx3.init()\n        self.tts_engine.setProperty('rate', 150)\n        \n        # Data directories\n        self.data_dir = Path(\"agent_data\")\n        self.data_dir.mkdir(exist_ok=True)\n        self.conversation_log = self.data_dir / \"conversations.json\"\n        self.memory_file = self.data_dir / \"memory.json\"\n        \n        self.system_prompt = \"\"\"You are an advanced AI assistant with access to:\n- Web search capabilities\n- File system operations\n- System information\n- Conversation memory\n\nWhen users ask:\n1. \"Search for...\" or \"Look up...\" \u2192 Use web search\n2. \"Read file...\" or \"Check file...\" \u2192 Read files\n3. \"Write to file...\" or \"Create file...\" \u2192 Write files\n4. \"What files...\" \u2192 List directory contents\n5. Regular questions \u2192 Answer from knowledge or suggest web search\n\nAlways be helpful, concise, and ask for clarification when needed.\nWhen performing actions, describe what you're doing step by step.\"\"\"\n        \n        self.conversation_history.append({\n            \"role\": \"system\",\n            \"content\": self.system_prompt\n        })\n        \n        self.load_memory()\n        print(\"\u2713 Advanced Voice Agent initialized\")\n    \n    def speak(self, text: str):\n        \"\"\"Convert text to speech.\"\"\"\n        try:\n            print(f\"\\n\ud83d\udd0a Agent: {text}\\n\")\n            self.tts_engine.say(text)\n            self.tts_engine.runAndWait()\n        except Exception as e:\n            print(f\"TTS error: {e}\")\n    \n    def listen(self) -> str:\n        \"\"\"Get user input (text or voice).\"\"\"\n        try:\n            user_input = input(\"\\n\ud83c\udfa4 You: \").strip()\n            return user_input\n        except KeyboardInterrupt:\n            return \"\"\n        except Exception as e:\n            print(f\"Input error: {e}\")\n            return \"\"\n    \n    def web_search(self, query: str, results: int = 5) -> str:\n        \"\"\"Perform web search using DuckDuckGo API (no key needed).\"\"\"\n        try:\n            print(f\"\ud83d\udd0d Searching for: {query}\")\n            \n            # Using DuckDuckGo instant answer API (free, no key required)\n            url = \"https://api.duckduckgo.com/\"\n            params = {\n                \"q\": query,\n                \"format\": \"json\",\n                \"no_html\": 1,\n            }\n            \n            response = requests.get(url, params=params, timeout=10)\n            data = response.json()\n            \n            # Extract relevant information\n            results_text = \"\"\n            \n            if data.get(\"AbstractText\"):\n                results_text = data[\"AbstractText\"]\n            elif data.get(\"Definition\"):\n                results_text = data[\"Definition\"]\n            else:\n                results_text = \"No specific answer found, but here's general information about your search.\"\n            \n            return results_text\n        \n        except Exception as e:\n            return f\"Search error: {e}. Continuing with general knowledge.\"\n    \n    def read_file(self, filename: str) -> str:\n        \"\"\"Read a file from disk.\"\"\"\n        try:\n            filepath = Path(filename)\n            if not filepath.exists():\n                return f\"File not found: {filename}\"\n            \n            with open(filepath, 'r', encoding='utf-8') as f:\n                content = f.read()\n            \n            if len(content) > 2000:\n                return f\"[File content (first 2000 chars)]\\n{content[:2000]}...\"\n            return content\n        \n        except Exception as e:\n            return f\"Error reading file: {e}\"\n    \n    def write_file(self, filename: str, content: str) -> str:\n        \"\"\"Write content to a file.\"\"\"\n        try:\n            filepath = Path(filename)\n            with open(filepath, 'w', encoding='utf-8') as f:\n                f.write(content)\n            return f\"\u2713 Successfully wrote to {filename}\"\n        except Exception as e:\n            return f\"Error writing file: {e}\"\n    \n    def list_files(self, directory: str = \".\") -> str:\n        \"\"\"List files in a directory.\"\"\"\n        try:\n            dirpath = Path(directory)\n            if not dirpath.exists():\n                return f\"Directory not found: {directory}\"\n            \n            files = list(dirpath.iterdir())\n            if not files:\n                return f\"Directory is empty: {directory}\"\n            \n            file_list = \"\\n\".join([f\"  - {f.name}\" for f in files[:20]])\n            return f\"Files in {directory}:\\n{file_list}\"\n        \n        except Exception as e:\n            return f\"Error listing files: {e}\"\n    \n    def execute_action(self, user_message: str) -> Optional[str]:\n        \"\"\"Check if user message requests an action and execute it.\"\"\"\n        message_lower = user_message.lower()\n        \n        # Web search\n        if any(word in message_lower for word in [\"search\", \"look up\", \"find\", \"what is\"]):\n            # Extract search query\n            search_query = user_message\n            for word in [\"search\", \"look up\", \"find\", \"what is\"]:\n                if word in message_lower:\n                    search_query = user_message.split(word, 1)[1].strip()\n                    break\n            \n            result = self.web_search(search_query)\n            return f\"Based on my search: {result}\"\n        \n        # Read file\n        if \"read\" in message_lower and \"file\" in message_lower:\n            # Extract filename\n            parts = user_message.lower().split(\"read\")\n            if len(parts) > 1:\n                filename = parts[1].replace(\"file\", \"\").strip()\n                result = self.read_file(filename)\n                return result\n        \n        # List files\n        if \"list\" in message_lower and \"file\" in message_lower:\n            result = self.list_files()\n            return result\n        \n        return None\n    \n    def process_message(self, user_message: str) -> str:\n        \"\"\"Process user message with actions and AI response.\"\"\"\n        if not user_message.strip():\n            return \"\"\n        \n        # Check for specific actions\n        action_result = self.execute_action(user_message)\n        if action_result:\n            self.conversation_history.append({\n                \"role\": \"user\",\n                \"content\": user_message\n            })\n            self.conversation_history.append({\n                \"role\": \"assistant\",\n                \"content\": action_result\n            })\n            return action_result\n        \n        # Regular AI conversation\n        self.conversation_history.append({\n            \"role\": \"user\",\n            \"content\": user_message\n        })\n        \n        try:\n            response = self.client.chat.completions.create(\n                model=\"gpt-4\",\n                messages=self.conversation_history,\n                max_tokens=500,\n                temperature=0.7\n            )\n            \n            assistant_message = response.choices[0].message.content\n            self.conversation_history.append({\n                \"role\": \"assistant\",\n                \"content\": assistant_message\n            })\n            \n            return assistant_message\n        \n        except Exception as e:\n            return f\"Error: {e}\"\n    \n    def save_conversation(self):\n        \"\"\"Save conversation to file.\"\"\"\n        try:\n            with open(self.conversation_log, 'w') as f:\n                json.dump(self.conversation_history, f, indent=2)\n        except Exception as e:\n            print(f\"Error saving conversation: {e}\")\n    \n    def load_memory(self):\n        \"\"\"Load memory from file.\"\"\"\n        try:\n            if self.memory_file.exists():\n                with open(self.memory_file, 'r') as f:\n                    memory = json.load(f)\n                    print(f\"\u2713 Loaded memory with {len(memory)} items\")\n        except Exception as e:\n            print(f\"Warning: Could not load memory: {e}\")\n    \n    def save_memory(self):\n        \"\"\"Save memory to file.\"\"\"\n        try:\n            memory = {\n                \"last_session\": datetime.now().isoformat(),\n                \"conversation_turns\": len(self.conversation_history),\n            }\n            with open(self.memory_file, 'w') as f:\n                json.dump(memory, f, indent=2)\n        except Exception as e:\n            print(f\"Error saving memory: {e}\")\n    \n    def run(self):\n        \"\"\"Main agent loop.\"\"\"\n        print(\"\\n\" + \"=\"*60)\n        print(\"\ud83c\udf99\ufe0f  ADVANCED VOICE AGENT\")\n        print(\"=\"*60)\n        print(\"Features: Web Search | File Operations | Memory\")\n        print(\"-\"*60)\n        print(\"Commands:\")\n        print(\"  - Search for [topic] \u2192 Web search\")\n        print(\"  - Read file [path] \u2192 Read file\")\n        print(\"  - List files \u2192 Show directory\")\n        print(\"  - quit/exit \u2192 Stop agent\")\n        print(\"=\"*60 + \"\\n\")\n        \n        greeting = \"Hello! I'm your advanced voice assistant. I can search the web, read files, and have conversations. What would you like to do?\"\n        self.speak(greeting)\n        \n        while self.is_running:\n            try:\n                user_message = self.listen()\n                \n                if not user_message:\n                    continue\n                \n                if user_message.lower() in ['quit', 'exit']:\n                    self.speak(\"Goodbye! Saving conversation...\")\n                    self.save_conversation()\n                    self.save_memory()\n                    self.is_running = False\n                    break\n                \n                if user_message.lower() in ['clear', 'reset']:\n                    self.conversation_history = [{\"role\": \"system\", \"content\": self.system_prompt}]\n                    self.speak(\"Conversation cleared.\")\n                    continue\n                \n                response = self.process_message(user_message)\n                if response:\n                    self.speak(response)\n            \n            except KeyboardInterrupt:\n                self.speak(\"Shutting down...\")\n                self.save_conversation()\n                self.save_memory()\n                self.is_running = False\n            except Exception as e:\n                print(f\"Error: {e}\")\n                self.speak(\"I encountered an error. Please try again.\")\n    \n    def cleanup(self):\n        \"\"\"Cleanup.\"\"\"\n        try:\n            self.tts_engine.stop()\n        except:\n            pass\n        print(\"\\n\u2713 Agent shutdown complete\")\n\n\nif __name__ == \"__main__\":\n    try:\n        agent = AdvancedVoiceAgent()\n        agent.run()\n    except Exception as e:\n        print(f\"Fatal error: {e}\")\n        sys.exit(1)\n    finally:\n        try:\n            agent.cleanup()\n        except:\n            pass\n"
}
