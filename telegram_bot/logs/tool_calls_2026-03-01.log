  "content": "\"\"\"\nConfiguration for the Voice Agent\n\"\"\"\n\nimport os\nfrom pathlib import Path\n\n# Get the directory where this script is located\nBASE_DIR = Path(__file__).parent\n\n# API Keys (Load from environment variables or .env file)\nOPENAI_API_KEY = os.getenv(\"OPENAI_API_KEY\", \"\")\nGOOGLE_API_KEY = os.getenv(\"GOOGLE_API_KEY\", \"\")\n\n# Agent Settings\nAGENT_NAME = \"Voice Assistant\"\nAGENT_VERSION = \"1.0.0\"\n\n# Voice Settings\nVOICE_RATE = 150  # Words per minute (100-300)\nVOICE_VOLUME = 0.9  # 0.0 to 1.0\nVOICE_GENDER = \"female\"  # or \"male\"\n\n# Audio Settings\nAUDIO_SAMPLE_RATE = 44100\nAUDIO_CHUNK_SIZE = 1024\nAUDIO_CHANNELS = 1\nAUDIO_FORMAT = 8  # pyaudio.paInt16\n\n# Recording Settings\nMAX_RECORDING_DURATION = 10  # seconds\nSILENCE_THRESHOLD = 0.01  # Amplitude threshold for silence detection\nSILENCE_DURATION = 1.5  # seconds of silence to trigger end of recording\n\n# LLM Settings\nLLM_MODEL = \"gpt-4\"  # or \"gpt-3.5-turbo\"\nLLM_TEMPERATURE = 0.7\nLLM_MAX_TOKENS = 500\n\n# Log Settings\nLOG_DIR = BASE_DIR / \"logs\"\nLOG_DIR.mkdir(exist_ok=True)\nLOG_FILE = LOG_DIR / \"voice_agent.log\"\n\n# Data Settings\nDATA_DIR = BASE_DIR / \"agent_data\"\nDATA_DIR.mkdir(exist_ok=True)\nCONVERSATION_LOG = DATA_DIR / \"conversations.json\"\nMEMORY_FILE = DATA_DIR / \"memory.json\"\n\n# Features\nENABLE_WEB_SEARCH = True\nENABLE_FILE_OPERATIONS = True\nENABLE_SYSTEM_CONTROL = True\nENABLE_MEMORY = True\n\n# Error Messages\nMISSING_API_KEY_MESSAGE = \"\"\"\n\u274c OpenAI API Key not found!\n\nTo use the Voice Agent, you need an OpenAI API key:\n\n1. Go to https://platform.openai.com/api-keys\n2. Create a new secret key\n3. Set it as an environment variable:\n   \n   Windows (PowerShell):\n   $env:OPENAI_API_KEY = \"sk-...\"\n   \n   Windows (CMD):\n   set OPENAI_API_KEY=sk-...\n   \n   Linux/Mac:\n   export OPENAI_API_KEY=\"sk-...\"\n\n4. Run this script again\n\"\"\"\n\nprint(__doc__)\n"
