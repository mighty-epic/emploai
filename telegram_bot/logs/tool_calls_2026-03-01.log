  "content": "\"\"\"\nSetup script for the Voice Agent\nHelps users obtain and configure API keys\n\"\"\"\n\nimport os\nimport sys\nimport json\nfrom pathlib import Path\nfrom typing import Optional\n\ndef print_banner():\n    \"\"\"Print welcome banner.\"\"\"\n    print(\"\"\"\n\u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557\n\u2551         VOICE AGENT SETUP & CONFIGURATION                 \u2551\n\u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255d\n    \"\"\")\n\ndef get_openai_api_key() -> Optional[str]:\n    \"\"\"Guide user to get OpenAI API key.\"\"\"\n    print(\"\\n\ud83d\udccc STEP 1: OpenAI API Key\")\n    print(\"\u2500\" * 60)\n    print(\"\"\"\nThe Voice Agent uses OpenAI's APIs for:\n- Speech-to-Text (Whisper)\n- Text Generation (GPT-4)\n- Text-to-Speech (TTS)\n\nSteps to get your API key:\n1. Go to: https://platform.openai.com/api-keys\n2. Sign up or log in to your OpenAI account\n3. Click \"Create new secret key\"\n4. Copy the key (starts with 'sk-')\n5. Paste it below\n\n\u26a0\ufe0f  IMPORTANT: Keep your API key PRIVATE!\n    Don't share it or commit it to version control.\n    \"\"\")\n    \n    api_key = input(\"Paste your OpenAI API key (or press Enter to skip): \").strip()\n    \n    if api_key:\n        if api_key.startswith(\"sk-\"):\n            print(\"\u2713 API key looks valid!\")\n            return api_key\n        else:\n            print(\"\u26a0\ufe0f  Key doesn't start with 'sk-'. Double-check and try again.\")\n            return None\n    return None\n\ndef get_google_api_key() -> Optional[str]:\n    \"\"\"Guide user to get Google API key (optional).\"\"\"\n    print(\"\\n\ud83d\udccc STEP 2: Google API Key (Optional)\")\n    print(\"\u2500\" * 60)\n    print(\"\"\"\nGoogle API key is optional and used for:\n- Enhanced web search capabilities\n- Google Cloud services integration\n\nTo get a Google API key:\n1. Go to: https://cloud.google.com/docs/authentication/api-keys\n2. Create a new project in Google Cloud Console\n3. Enable the APIs you need\n4. Create an API key\n5. Paste it below (or skip)\n    \"\"\")\n    \n    api_key = input(\"Paste your Google API key (or press Enter to skip): \").strip()\n    return api_key if api_key else None\n\ndef check_dependencies():\n    \"\"\"Check if required dependencies are installed.\"\"\"\n    print(\"\\n\ud83d\udccc STEP 3: Checking Dependencies\")\n    print(\"\u2500\" * 60)\n    \n    required = {\n        \"openai\": \"OpenAI\",\n        \"pyaudio\": \"PyAudio\",\n        \"pyttsx3\": \"pyttsx3\",\n        \"pydub\": \"pydub\",\n        \"requests\": \"requests\",\n        \"dotenv\": \"python-dotenv\",\n    }\n    \n    missing = []\n    for module, name in required.items():\n        try:\n            __import__(module)\n            print(f\"\u2713 {name} is installed\")\n        except ImportError:\n            print(f\"\u2717 {name} is NOT installed\")\n            missing.append(name)\n    \n    if missing:\n        print(f\"\\nMissing packages: {', '.join(missing)}\")\n        install = input(\"\\nWould you like to install missing dependencies? (y/n): \").strip().lower()\n        \n        if install == 'y':\n            print(\"\\nInstalling dependencies... (this may take a few minutes)\")\n            os.system(f\"{sys.executable} -m pip install -q -r requirements.txt\")\n            print(\"\u2713 Dependencies installed!\")\n        else:\n            print(\"\u26a0\ufe0f  Some dependencies are missing. The agent may not work properly.\")\n    else:\n        print(\"\\n\u2713 All dependencies are installed!\")\n\ndef create_env_file(openai_key: Optional[str], google_key: Optional[str]):\n    \"\"\"Create .env file with API keys.\"\"\"\n    print(\"\\n\ud83d\udccc STEP 4: Saving Configuration\")\n    print(\"\u2500\" * 60)\n    \n    env_content = \"# Voice Agent Environment Variables\\n\"\n    \n    if openai_key:\n        env_content += f\"OPENAI_API_KEY={openai_key}\\n\"\n        print(\"\u2713 OpenAI API key saved\")\n    else:\n        print(\"\u26a0\ufe0f  OpenAI API key not set\")\n    \n    if google_key:\n        env_content += f\"GOOGLE_API_KEY={google_key}\\n\"\n        print(\"\u2713 Google API key saved\")\n    \n    env_file = Path(\".env\")\n    env_file.write_text(env_content)\n    \n    print(f\"\\n\u2713 Configuration saved to: {env_file.absolute()}\")\n    print(\"\\n\u26a0\ufe0f  SECURITY WARNING:\")\n    print(\"   - Add .env to .gitignore to prevent committing secrets\")\n    print(\"   - Never share your .env file\")\n    print(\"   - Keep your API keys confidential\")\n\ndef create_gitignore():\n    \"\"\"Create/update .gitignore to exclude .env and sensitive files.\"\"\"\n    gitignore_path = Path(\".gitignore\")\n    \n    essential_ignores = [\n        \".env\",\n        \"*.pyc\",\n        \"__pycache__/\",\n        \".DS_Store\",\n        \"temp_audio.*\",\n        \"logs/\",\n        \".venv/\",\n        \"venv/\",\n    ]\n    \n    if gitignore_path.exists():\n        content = gitignore_path.read_text()\n    else:\n        content = \"\"\n    \n    for item in essential_ignores:\n        if item not in content:\n            content += f\"\\n{item}\"\n    \n    gitignore_path.write_text(content.strip())\n    print(f\"\u2713 Updated .gitignore\")\n\ndef main():\n    \"\"\"Main setup flow.\"\"\"\n    print_banner()\n    \n    # Step 1: Get OpenAI key\n    openai_key = None\n    while not openai_key:\n        openai_key = get_openai_api_key()\n        if not openai_key:\n            retry = input(\"Try again? (y/n): \").strip().lower()\n            if retry != 'y':\n                print(\"\u26a0\ufe0f  OpenAI API key is required for the voice agent to work!\")\n                break\n    \n    # Step 2: Get Google key (optional)\n    google_key = get_google_api_key()\n    \n    # Step 3: Check dependencies\n    check_dependencies()\n    \n    # Step 4: Save configuration\n    if openai_key or google_key:\n        create_env_file(openai_key, google_key)\n        create_gitignore()\n    \n    # Summary\n    print(\"\\n\" + \"=\"*60)\n    print(\"\u2713 SETUP COMPLETE!\")\n    print(\"=\"*60)\n    print(\"\"\"\nNext steps:\n1. Run the voice agent:\n   python voice_agent.py\n\n2. The agent will:\n   - Listen to your voice input\n   - Process it using OpenAI APIs\n   - Respond with synthesized speech\n\n3. You can control it with:\n   - Voice commands\n   - Text input (fallback)\n   - 'quit' to exit\n\nFor more information, check:\n   - config.py (settings)\n   - voice_agent.py (main code)\n   - logs/ (execution logs)\n\nGood luck! \ud83c\udf99\ufe0f\n    \"\"\")\n\nif __name__ == \"__main__\":\n    try:\n        main()\n    except KeyboardInterrupt:\n        print(\"\\n\\n\u274c Setup cancelled by user\")\n        sys.exit(1)\n    except Exception as e:\n        print(f\"\\n\u274c Setup error: {e}\")\n        import traceback\n        traceback.print_exc()\n        sys.exit(1)\n"
}
