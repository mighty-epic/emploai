# Telegram Agent Security Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env files to version control!

# =============================================================================
# REQUIRED: Telegram Bot Configuration
# =============================================================================

# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated list of allowed Telegram user IDs
# You can get your user ID by messaging @userinfobot
ALLOWED_USER_IDS=123456789,987654321

# =============================================================================
# OPTIONAL: Rate Limiting Configuration
# =============================================================================

# Maximum requests per minute per command (default: 30)
MAX_REQUESTS_PER_MINUTE=30

# Maximum requests per hour per command (default: 200)
MAX_REQUESTS_PER_HOUR=200

# =============================================================================
# OPTIONAL: Beta Mode
# =============================================================================

# Set to true to restrict expensive models (e.g. Claude Sonnet/Opus).
# Only cheap Anthropic models (Haiku) will be available.
# All other providers (OpenAI, Google, xAI, etc.) remain unrestricted.
BETA_MODE=false

# =============================================================================
# OPTIONAL: Workspace Configuration
# =============================================================================

# Default workspace directory for file operations
# Paths outside this directory will be rejected for security
DEFAULT_WORKSPACE=/path/to/your/workspace

# =============================================================================
# API Keys for LLM Providers (required for functionality)
# =============================================================================

# OpenAI API Key (for GPT models)
OPENAI_API_KEY=your_openai_key_here

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Google/Gemini API Key (for Gemini models)
GOOGLE_API_KEY=your_google_key_here
GEMINI_API_KEY=your_gemini_key_here

# xAI API Key (for Grok models)
XAI_API_KEY=your_xai_key_here

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_key_here

# OpenRouter API Key (for accessing multiple providers)
OPENROUTER_API_KEY=your_openrouter_key_here

# =============================================================================
# OPTIONAL: Linux Headed Desktop Deployment
# =============================================================================

# Force Linux desktop overrides when needed
# PLATFORM=linux

# Shared X11 display used by the display + bot services
# DISPLAY=:99

# Set to false for headed Chrome / extension-bridge workflows
# HEADLESS=false

# =============================================================================
# Security Notes
# =============================================================================

# 1. Never share your bot token or API keys
# 2. Keep your .env file secure and out of version control
# 3. Add .env to your .gitignore file
# 4. Regularly rotate API keys for security
# 5. Use the /security command in Telegram to check security status

# =============================================================================
