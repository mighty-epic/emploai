# Telegram Agent Security Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env files to version control!

# =============================================================================
# REQUIRED: Telegram Bot Configuration
# =============================================================================

# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Runtime profile. Set to production on internet-facing deployments.
EMPLOAI_ENV=development

# Required when EMPLOAI_ENV=production unless TELEGRAM_BOT_TOKEN is also set.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
EMPLO_APP_SECRET=

# Comma-separated list of allowed Telegram user IDs
# You can get your user ID by messaging @userinfobot
ALLOWED_USER_IDS=123456789,987654321

# =============================================================================
# OPTIONAL: Rate Limiting Configuration
# =============================================================================

# Maximum requests per minute per command (default: 30)
MAX_REQUESTS_PER_MINUTE=30

# Maximum requests per hour per command (default: 200)
MAX_REQUESTS_PER_HOUR=200

# =============================================================================
# OPTIONAL: Beta Mode
# =============================================================================

# Set to true to restrict expensive models (e.g. Claude Sonnet/Opus).
# Only cheap Anthropic models (Haiku) will be available.
# All other providers (OpenAI, Google, xAI, etc.) remain unrestricted.
BETA_MODE=false

# =============================================================================
# OPTIONAL: Workspace Configuration
# =============================================================================

# Default workspace directory for file operations
# Paths outside this directory will be rejected for security
DEFAULT_WORKSPACE=/path/to/your/workspace

# Default main/planner models for the app runtime. Use auto to keep the main
# model and planner on the same configured provider.
AGENT_DEFAULT_MODEL=auto
PLANNER_MODEL=auto
EMPLOAI_FINAL_QUALITY_GUARD=planner
EMPLOAI_FINAL_QUALITY_MAX_AUTO_CONTINUES=2

# Keep disabled outside local debugging. When enabled, unexpected API crashes
# include full tracebacks in HTTP 500 JSON responses.
EMPLOAI_DEBUG_ERROR_RESPONSES=0

# Email OTP delivery for regular email/password signup and login.
# Missing delivery config fails account creation. Use `console` only for local/dev code logs.
EMPLOAI_EMAIL_BACKEND=resend
EMPLOAI_EMAIL_FROM=EmploAI <no-reply@kraitos.app>
RESEND_API_KEY=

# =============================================================================
# API Keys for LLM Providers (required for functionality)
# =============================================================================

# OpenAI API Key (for GPT models)
OPENAI_API_KEY=your_openai_key_here

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Google/Gemini API Key (for Gemini models)
GOOGLE_API_KEY=your_google_key_here
GEMINI_API_KEY=your_gemini_key_here

# xAI API Key (for Grok models)
XAI_API_KEY=your_xai_key_here

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_key_here

# NVIDIA API Key (for NVIDIA NIM / build.nvidia.com models)
NVIDIA_API_KEY=your_nvidia_key_here

# OpenRouter API Key (for accessing multiple providers)
OPENROUTER_API_KEY=your_openrouter_key_here

# =============================================================================
# OPTIONAL: Jarvis Voice / TTS
# =============================================================================

# Defaults to OpenAI TTS. Set to kokoro_onnx or pocket for local Jarvis speech.
EMPLO_APP_TTS_BACKEND=openai
EMPLO_APP_TTS_ENABLED=1

# Defaults to local Whisper. Set to openai_realtime for low-latency OpenAI
# Realtime API transcription while keeping the normal assistant/TTS pipeline.
EMPLO_APP_STT_BACKEND=local_whisper
EMPLO_APP_STT_REALTIME_MODEL=gpt-realtime-whisper
EMPLO_APP_STT_REALTIME_TRANSCRIPTION_MODEL=
EMPLO_APP_STT_REALTIME_URL=
EMPLO_APP_STT_REALTIME_TIMEOUT_SECONDS=8
EMPLO_APP_STT_REALTIME_APPEND_TIMEOUT_SECONDS=6
EMPLO_APP_STT_REALTIME_NOISE_REDUCTION=near_field

# Jarvis uses confirmed draft STT when possible and caps pending draft waits.
EMPLO_APP_JARVIS_FAST_FINAL=1
EMPLO_APP_JARVIS_PENDING_WAIT_MS=180

# Managed desktop speech packs. Pack repos are normally injected from
# deploy/windows/release_info.json in packaged builds.
EMPLO_APP_TTS_KOKORO_PACK_REPO=
EMPLOAI_KOKORO_TTS_PACK_REVISION=main
EMPLOAI_KOKORO_TTS_PACK_SOURCE_DIR=
EMPLO_APP_TTS_KYUTAI_PACK_REPO=
EMPLOAI_KYUTAI_TTS_PACK_REVISION=main
EMPLOAI_KYUTAI_TTS_PACK_SOURCE_DIR=

# Optional local/dev Kokoro overrides. Pack installs use managed paths instead.
EMPLO_APP_KOKORO_TTS_SITE_PACKAGES=
EMPLO_APP_KOKORO_TTS_MODEL=
EMPLO_APP_KOKORO_TTS_VOICES=
EMPLO_APP_KOKORO_TTS_VOICE=jarvis
EMPLO_APP_KOKORO_TTS_LANGUAGE=en-us
EMPLO_APP_KOKORO_TTS_SPEED=1.08

# Required only when EMPLO_APP_TTS_BACKEND=pocket outside the managed pack flow.
# Use an absolute path to a Pocket TTS .safetensors voice state.
EMPLO_APP_POCKET_TTS_VOICE=
EMPLO_APP_POCKET_TTS_LANGUAGE=english
EMPLO_APP_POCKET_TTS_QUANTIZE=0

# Optional: site-packages folder containing pocket_tts for local/dev installs.
EMPLO_APP_POCKET_TTS_SITE_PACKAGES=

# =============================================================================
# OPTIONAL: Linux Headed Desktop Deployment
# =============================================================================

# Force Linux desktop overrides when needed
# PLATFORM=linux

# Shared X11 display used by the display + bot services
# DISPLAY=:99

# Set to false for headed Chrome / extension-bridge workflows
# HEADLESS=false

# =============================================================================
# Security Notes
# =============================================================================

# 1. Never share your bot token or API keys
# 2. Keep your .env file secure and out of version control
# 3. Add .env to your .gitignore file
# 4. Regularly rotate API keys for security
# 5. Use the /security command in Telegram to check security status

# =============================================================================
