{
  "name": "emploai-desktop-shell",
  "version": "0.1.0-beta.14.6",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File ../scripts/desktop/start.ps1",
    "start:fast": "powershell -ExecutionPolicy Bypass -File ../scripts/desktop/start.ps1 -Fast",
    "start:electron": "electron .",
    "start:check": "powershell -ExecutionPolicy Bypass -File ../scripts/desktop/start.ps1 -CheckOnly",
    "dev": "npm run start:fast",
    "build:renderer": "npm --prefix renderer_client run export:web",
    "fleet:yggdrasil:status": "cd .. && python -m desktop_runtime.backend yggdrasil-status",
    "fleet:yggdrasil:bootstrap": "cd .. && python -m desktop_runtime.backend yggdrasil-bootstrap --install --start --configure-default-peers",
    "fleet:yggdrasil:pair": "cd .. && python -m desktop_runtime.backend fleet-yggdrasil-pair --configure-manager-bind",
    "fleet:yggdrasil:join": "cd .. && python -m desktop_runtime.backend fleet-yggdrasil-join",
    "fleet:host:status": "cd .. && python -m desktop_runtime.backend fleet-host-status",
    "fleet:host:start": "cd .. && python -m desktop_runtime.backend fleet-host-start",
    "fleet:host:install": "cd .. && python -m desktop_runtime.backend fleet-host-install",
    "fleet:host:uninstall": "cd .. && python -m desktop_runtime.backend fleet-host-uninstall",
    "smoke:chat": "py -3.13 ..\\scripts\\smoke_desktop_chat.py",
    "release:check": "python ../scripts/check_release_hygiene.py",
    "prepackage:win": "npm run release:check",
    "package:win": "node -e \"console.log('Windows MSI/package build is disabled for standalone desktop mode. Use npm run package:win:legacy to run the old packager.')\"",
    "package:win:legacy": "powershell -ExecutionPolicy Bypass -File ../deploy/windows/build_beta_release.ps1"
  },
  "devDependencies": {
    "electron": "^35.5.1",
    "electron-packager": "^17.1.2"
  }
}
